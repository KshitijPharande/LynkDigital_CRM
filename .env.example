# Environment variables for LynkDigital CRM
# Connect to your Supabase PostgreSQL Database (Transaction Pooler or Direct)
# Example Supabase format:
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lynkdigital?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/lynkdigital?schema=public"

# Session & JWT Secret
JWT_SECRET="lynkdigital-crm-jwt-secret-key-32-chars-long-secure"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
